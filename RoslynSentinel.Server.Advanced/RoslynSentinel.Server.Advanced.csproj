<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;DebugVisualStudio</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>1</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>1</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='DebugVisualStudio|AnyCPU'">
    <WarningLevel>1</WarningLevel>
  </PropertyGroup>

	<ItemGroup>
		<!-- MSBuild packages: same pattern as RoslynSentinel.Server - exclude runtime DLLs
         so MSBuildLocator can find the SDK-provided MSBuild at runtime instead. -->
		<PackageReference Include="Microsoft.Build.Framework" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all">
			<IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
		<PackageReference Include="Microsoft.NET.StringTools" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all">
			<IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
		<PackageReference Include="ModelContextProtocol" Version="2.2.0" />
		<!-- HTTP transport for MCP -->
		<PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
		<PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
		<!-- MCP Tasks extension: lets long-running tools return a taskId handle instead of blocking -->
		<PackageReference Include="ModelContextProtocol.Extensions.Tasks" Version="2.2.0" />
		<!-- IHttpClientFactory (AddHttpClient<T>) for LmStudioClient -->
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<!-- Logging -->
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoslynSentinel.Common\RoslynSentinel.Common.csproj" />
    <ProjectReference Include="..\RoslynSentinel.Server.Basic\RoslynSentinel.Server.Basic.csproj" />
    <ProjectReference Include="..\RoslynSentinel.Tools.Advanced\RoslynSentinel.Tools.Advanced.csproj" />
    <ProjectReference Include="..\RoslynSentinel.Tools.Basic\RoslynSentinel.Tools.Basic.csproj" />
    <ProjectReference Include="..\RoslynSentinel.Tools.Experimental\RoslynSentinel.Tools.Experimental.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="RoslynSentinel.Common" />
  </ItemGroup>

</Project>
