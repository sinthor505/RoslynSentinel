<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RunAnalyzersDuringBuild>False</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
    <EnableNETAnalyzers>False</EnableNETAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>0</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>0</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="coverlet.collector" Version="10.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
	  <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
	  <PackageReference Include="NUnit.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
	  <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoslynSentinel.Common\RoslynSentinel.Common.csproj" />
    <ProjectReference Include="..\RoslynSentinel.Engines.Basic\RoslynSentinel.Engines.Basic.csproj" />
    <ProjectReference Include="..\RoslynSentinel.Tests\RoslynSentinel.Tests.csproj" />
    <ProjectReference Include="..\RoslynSentinel.Tests.Support.Basic\RoslynSentinel.Tests.Support.Basic.csproj" />
    <ProjectReference Include="..\RoslynSentinel.Tools.Basic\RoslynSentinel.Tools.Basic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden wire envelopes shared with Tests.Server (EnvelopeLargeResultPagingTests); regenerate with scripts/New-WireResultGoldens.ps1. -->
    <EmbeddedResource Include="..\RoslynSentinel.Tests.Server\Resources\Golden\*.json" LogicalName="Golden.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Temporary stand-in for Step 18; removed when the files have moved. These files are compiled by
         RoslynSentinel.Tests.Git through links (same wildcard patterns as its csproj), so they are removed here. -->
    <Compile Remove="Git*.cs" />
    <Compile Remove="Cas?ommitTestSupport.cs" />
    <Compile Remove="ShortHashLengthsTest?.cs" />
    <Compile Remove="RepoPathWorktreeTest?.cs" />
    <Compile Remove="McpServerStatusGitBackendTest?.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="RoslynSentinel.Common" />
  </ItemGroup>

</Project>
