{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/enforce-dogfood.ps1"
            ]
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(tasklist)",
      "Bash(tasklist *)",

      "mcp__root_roslyn_sentinel_advanced_stdio__AcknowledgeExternalFileChanges",
      "mcp__root_roslyn_sentinel_advanced_stdio__ApplyDiff",
      "mcp__root_roslyn_sentinel_advanced_stdio__ApplyUnifiedDiff",
      "mcp__root_roslyn_sentinel_advanced_stdio__Build",
      "mcp__root_roslyn_sentinel_advanced_stdio__ChangeAccessibility",
      "mcp__root_roslyn_sentinel_advanced_stdio__ChangeSignature",
      "mcp__root_roslyn_sentinel_advanced_stdio__CreateFile",
      "mcp__root_roslyn_sentinel_advanced_stdio__DeleteFile",
      "mcp__root_roslyn_sentinel_advanced_stdio__FindReferences",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetBestInsertionPoint",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetCallGraph",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetCodeInventory",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetDiagnostics",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetFileOutline",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetLargeResult",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetMethodSource",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetOperationDetail",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetPublicApiSurface",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetSolutionMetrics",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetTypeInfo",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetWorkspaceHealth",
      "mcp__root_roslyn_sentinel_advanced_stdio__Git",
