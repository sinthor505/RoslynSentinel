      "mcp__root_roslyn_sentinel_advanced_stdio__ModifyModifier",
      "mcp__root_roslyn_sentinel_advanced_stdio__PreviewRenameImpact",
      "mcp__root_roslyn_sentinel_advanced_stdio__ReadFile",
      "mcp__root_roslyn_sentinel_advanced_stdio__RenameSymbol",
      "mcp__root_roslyn_sentinel_advanced_stdio__ReplaceSnippet",
      "mcp__root_roslyn_sentinel_advanced_stdio__RunTest",
      "mcp__root_roslyn_sentinel_advanced_stdio__UndoLastApply",
      "mcp__root_roslyn_sentinel_advanced_stdio__UsingDirective",
