{
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/Users/Administrator/source/repos/RoslynSentinel/.claude/hooks/usage-statusline.ps1"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/usage-nudge.ps1"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Grep|Agent|Task|.*__ReplaceSnippet|.*__Git",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/enforce-dogfood.ps1"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/usage-nudge.ps1"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*__Build",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-build-staleness.ps1"
            ]
          }
        ]
      },
      {
        "matcher": "mcp__.*roslyn_sentinel.*|Read|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/journal-log-call.ps1"
            ],
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*roslyn_sentinel.*|Read|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/journal-log-call.ps1"
            ],
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/journal-session-start.ps1"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/journal-stop-nudge.ps1"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(tasklist)",
      "Bash(tasklist *)",

      "mcp__root_roslyn_sentinel_advanced_stdio__ApplyDiff",
      "mcp__root_roslyn_sentinel_advanced_stdio__ApplyUnifiedDiff",
      "mcp__root_roslyn_sentinel_advanced_stdio__Build",
      "mcp__root_roslyn_sentinel_advanced_stdio__ChangeAccessibility",
      "mcp__root_roslyn_sentinel_advanced_stdio__ChangeSignature",
      "mcp__root_roslyn_sentinel_advanced_stdio__CreateFile",
      "mcp__root_roslyn_sentinel_advanced_stdio__DeleteFile",
      "mcp__root_roslyn_sentinel_advanced_stdio__ExternalFileDrift",
      "mcp__root_roslyn_sentinel_advanced_stdio__FindReferences",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetBestInsertionPoint",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetCallGraph",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetCodeInventory",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetDiagnostics",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetFileOutline",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetLargeResult",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetMethodSource",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetOperationDetail",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetPublicApiSurface",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetSolutionMetrics",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetTypeInfo",
      "mcp__root_roslyn_sentinel_advanced_stdio__GetWorkspaceHealth",
      "mcp__root_roslyn_sentinel_advanced_stdio__Git",
      "mcp__root_roslyn_sentinel_advanced_stdio__InspectSymbol",
      "mcp__root_roslyn_sentinel_advanced_stdio__ListAll",
      "mcp__root_roslyn_sentinel_advanced_stdio__ListProjectFrameworkTargets",
      "mcp__root_roslyn_sentinel_advanced_stdio__ListSolutionItems",
      "mcp__root_roslyn_sentinel_advanced_stdio__ListWorkspaceSolutions",
      "mcp__root_roslyn_sentinel_advanced_stdio__LoadSolution",
      "mcp__root_roslyn_sentinel_advanced_stdio__LocateSymbol",
      "mcp__root_roslyn_sentinel_advanced_stdio__Member",
