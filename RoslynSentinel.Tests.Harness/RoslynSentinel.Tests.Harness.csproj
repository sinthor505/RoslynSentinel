<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Prevents static code analysis rules from running on this project -->
    <RunCodeAnalysis>false</RunCodeAnalysis>
    <IsCodeAnalysisAnalyzersExecuted>false</IsCodeAnalysisAnalyzersExecuted>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <Configurations>Debug;Release;DebugVisualStudio</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>1</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>1</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='DebugVisualStudio|AnyCPU'">
    <WarningLevel>1</WarningLevel>
  </PropertyGroup>

  <!-- Model-free harness tests (SubAgent tool, PlanStepRunner, later the model-free ModelEval fixtures). Deliberately NOT named *.ModelEval/*.SubAgent/*.PlanStepRunner: scripts/Invoke-WorktreeTests.ps1 excludes those live projects whole, and every test here runs without a model host (punchlist #27). -->

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <!-- The referenced Exe projects' Main methods live in referenced assemblies, so there is no entry-point conflict and no StartupObject is set. -->
  <ItemGroup>
    <ProjectReference Include="..\RoslynSentinel.AgentLoop\RoslynSentinel.AgentLoop.csproj" />
    <ProjectReference Include="..\RoslynSentinel.Common\RoslynSentinel.Common.csproj" />
    <ProjectReference Include="..\RoslynSentinel.Server.Advanced\RoslynSentinel.Server.Advanced.csproj" />
    <ProjectReference Include="..\RoslynSentinel.Tools.Advanced\RoslynSentinel.Tools.Advanced.csproj" />
    <ProjectReference Include="..\RoslynSentinel.Tests.Support.Basic\RoslynSentinel.Tests.Support.Basic.csproj" />
    <ProjectReference Include="..\RoslynSentinel.Tests\RoslynSentinel.Tests.csproj" />
    <ProjectReference Include="..\RoslynSentinel.Utilities.PlanStepRunner\RoslynSentinel.Utilities.PlanStepRunner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="RoslynSentinel.Common" />
  </ItemGroup>

</Project>
