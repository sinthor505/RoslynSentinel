<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;DebugVisualStudio</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>1</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>1</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='DebugVisualStudio|AnyCPU'">
    <WarningLevel>1</WarningLevel>
  </PropertyGroup>

	<ItemGroup>
		<!-- MSBuild packages already come in transitively via RoslynSentinel.Engines.Basic. -->
		<!-- HTTP transport for MCP -->
		<PackageReference Include="ModelContextProtocol" Version="2.2.0" />
		<PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<!-- Logging -->
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoslynSentinel.Common\RoslynSentinel.Common.csproj" />
    <ProjectReference Include="..\RoslynSentinel.Engines.Basic\RoslynSentinel.Engines.Basic.csproj" />
    <ProjectReference Include="..\RoslynSentinel.Tools.Basic\RoslynSentinel.Tools.Basic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="RoslynSentinel.Common" />
  </ItemGroup>

</Project>
