<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<ItemGroup>
		<!-- MSBuild packages already come in transitively via RoslynSentinel.Basic. -->
		<!-- HTTP transport for MCP -->
		<PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
		<!-- Logging -->
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoslynSentinel.Basic\RoslynSentinel.Basic.csproj" />
    <ProjectReference Include="..\RoslynSentinel.Common\RoslynSentinel.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ModelContextProtocol.Protocol" />
    <Using Include="RoslynSentinel.Basic" />
    <Using Include="RoslynSentinel.Common" />
  </ItemGroup>

</Project>
