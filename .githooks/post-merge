#!/bin/sh
# Starts a detached background prebuild of the RoslynSentinel server (scripts/Start-ServerPrebuild.ps1). Never fails or delays the git operation.
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(git rev-parse --show-toplevel)/scripts/Start-ServerPrebuild.ps1" >/dev/null 2>&1 || true
exit 0
