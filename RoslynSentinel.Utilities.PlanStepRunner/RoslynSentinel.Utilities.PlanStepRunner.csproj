<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- RoslynSentinel.Tests.ModelEval transitively project-references Server.Advanced,
         an OutputType=Exe with its own Main - StartupObject pins which one is this exe's entry
         point instead of failing the build with CS0017 (multiple entry points). -->
    <StartupObject>RoslynSentinel.Utilities.PlanStepRunner.Program</StartupObject>
    <Configurations>Debug;Release;DebugVisualStudio</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>1</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>1</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='DebugVisualStudio|AnyCPU'">
    <WarningLevel>1</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoslynSentinel.Common\RoslynSentinel.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="RoslynSentinel.Common" />
  </ItemGroup>

</Project>
