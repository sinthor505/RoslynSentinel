ClaudeFiles/
*.csv
*.json

# The blanket *.json above swallows the Claude Code project config; this negation counters
# that one specifically (the .claude/* block further down needs its own separate negation -
# see the comment there). settings.local.json stays ignored: it's per-machine (absolute
# paths, personal permission grants).
!.claude/settings.json

# Golden wire payloads for ResultPagerTests are embedded test resources (generated by
# scripts/New-WireResultGoldens.ps1) and must be committed or the Tests.Server build breaks on a clean clone.
!RoslynSentinel.Tests.Server/Resources/Golden/
!RoslynSentinel.Tests.Server/Resources/Golden/*.json

# Trimmed transcripts the resume scenarios (plan_targeted_tool_scenario_evals step 8d) seed from; tracked so a clean clone can run them.
!RoslynSentinel.Tests.ModelEval/ResumeTranscripts/
!RoslynSentinel.Tests.ModelEval/ResumeTranscripts/*.json

*.trx

TestResults/

_scratchbuild/
_scratchbuild_*/
lmstudio_logs/
ModelTestingResults/
PlanStepRunner/


# NOTE: git cannot re-include a file whose PARENT DIRECTORY is itself excluded - a bare
# ".claude/" pattern here would make every !.claude/... negation below a no-op for anything
# not already tracked (this bit us once: enforce-dogfood.ps1 only appeared trackable because
# it was already committed, not because its negation actually worked for new files). So this
# excludes .claude/'s contents file-by-file instead of the directory itself, leaving room for
# the hooks/ and settings.json negations below to actually apply.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/**
.claude/hooks/bin/
!.claude/skills/
!.claude/skills/**
!.claude/implementer-tiers.json
docs/known-build-warnings.Solution.txt
*.tmp
/.scratch
# Server runtime state (operation blobs, large results, scans, test instances, write lock). Nothing here is tracked.
/.roslynsentinel/
